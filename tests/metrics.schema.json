          "$ref": "#/$defs/lists"
        },
        "unused": {
          "$ref": "#/$defs/lists"
        },
        "days": {
          "type": "object",
          "maxProperties": 14,
          "additionalProperties": false,
          "patternProperties": {
            "^\\d{4}-\\d{2}-\\d{2}$": {
              "$ref": "#/$defs/day"
            }
          }
        },
