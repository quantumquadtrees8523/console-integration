    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ok": {
          "$ref": "#/$defs/count"
        },
        "failed": {
          "$ref": "#/$defs/count"
        },
        "unconfirmed": {
          "$ref": "#/$defs/count"
        }
      }
    },
