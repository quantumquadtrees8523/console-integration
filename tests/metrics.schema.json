            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "text": {
              "type": "string",
              "maxLength": 1500,
              "pattern": "^[A-Za-z0-9 '.,:()\\-]*$",
              "x-story-words": [
