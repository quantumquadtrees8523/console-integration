{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://console-home.fly.dev/protocol/metrics.schema.json",
  "title": "Usage details: a box's answer to GET /api/console/relay/metrics",
  "description": "Version 1. Counts by UTC day from fixed lists, what exists on the box, what was never used, and a story whose every word is in x-story-words. Nothing else is accepted: no unknown key, no id outside the lists. At most 65536 bytes.",
  "x-max-bytes": 65536,
  "oneOf": [
    {
      "$ref": "#/$defs/off"
    },
    {
      "$ref": "#/$defs/held"
    },
    {
      "$ref": "#/$defs/report"
    }
  ],
